# Handle line endings consistently across Windows/macOS/Linux
* text=auto

# Python files — always LF
*.py    text eol=lf
*.pyi   text eol=lf

# Config/text files — LF
*.txt   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.env   text eol=lf
*.sh    text eol=lf

# HTML/CSS/JS — LF
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# Binary files — no conversion
*.pt    binary
*.pth   binary
*.onnx  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.mp4   binary
*.zip   binary

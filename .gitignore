# =============================================================
#  HEKAFALLS 2026 — .gitignore
#  Python monorepo: aegis-backend (FastAPI) + aegis-vision (YOLO)
# =============================================================

# ─────────────────────────────────────────
#  🔑  SECRETS & CREDENTIALS  ← CRITICAL
# ─────────────────────────────────────────
# Never commit real API keys, DB URIs, or passwords.
# Use .env files locally and load via python-dotenv.
.env
.env.*
!.env.example          # ← allow the template to be committed
**/config_local.py
**/secrets.py

# config.py files contain hardcoded secrets in this project.
# Developers should copy config.py.example → config.py and fill in real values.
# config.py is intentionally gitignored to prevent secret leaks.
config.py

# ─────────────────────────────────────────
#  🐍  PYTHON
# ─────────────────────────────────────────
# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytest.ini
.testmondata

# Translations
*.mo
*.pot

# Jupyter / IPython
.ipynb_checkpoints
*.ipynb

# mypy / pyright / ruff
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.ruff_cache/

# ─────────────────────────────────────────
#  📦  VIRTUAL ENVIRONMENTS
# ─────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
Pipfile.lock

# ─────────────────────────────────────────
#  🤖  AI / ML MODELS  (large binary files)
# ─────────────────────────────────────────
# YOLO model weights — download at runtime, don't commit
*.pt
*.pth
*.onnx
*.pb
*.tflite
*.weights
*.h5
*.hdf5
models/
checkpoints/

# Dataset files
*.csv
*.parquet
*.arrow
data/
datasets/

# ─────────────────────────────────────────
#  🗄️  DATABASES & DUMPS
# ─────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
*.bak

# ─────────────────────────────────────────
#  📝  LOGS & RUNTIME ARTIFACTS
# ─────────────────────────────────────────
logs/
*.log
*.log.*
*.out

# ─────────────────────────────────────────
#  🖼️  MEDIA / UPLOADS (generated at runtime)
# ─────────────────────────────────────────
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.mp4
*.avi
*.mov
*.mkv
uploads/
frames/
snapshots/

# ─────────────────────────────────────────
#  🛠️  SCRATCH / DEV UTILITIES
# ─────────────────────────────────────────
# One-off debug scripts not meant for the repo
scratch/
**/scratch/
tmp/
temp/

# ─────────────────────────────────────────
#  💻  OS & EDITOR FILES
# ─────────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# VS Code
.vscode/
!.vscode/extensions.json   # allow sharing recommended extensions
!.vscode/settings.json     # allow sharing workspace settings

# JetBrains (PyCharm / IntelliJ)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ─────────────────────────────────────────
#  🔥  FIREBASE
# ─────────────────────────────────────────
# Service account key — NEVER commit this!
*serviceAccountKey*.json
firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# ─────────────────────────────────────────
#  🌐  NODE / FRONTEND (if added later)
# ─────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
.next/
.nuxt/
.output/
.cache/

# ─────────────────────────────────────────
#  ☁️  DEPLOYMENT / INFRA
# ─────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
docker-compose.override.yml

# ─────────────────────────────────────────
#  📌  PROJECT-SPECIFIC OVERRIDES
# ─────────────────────────────────────────
# Allow these important files despite pattern matches above
!requirements.txt
!**/requirements.txt
!**/requirements-dev.txt
!.env.example
!**/static/index.html
!config.py.example
!**/config.py.example

# Keep design docs and startup notes tracked
!design.txt
!startup_code.txt
!implementation_plan.md

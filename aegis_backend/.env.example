# =============================================================
#  aegis-backend — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git — only .env.example is committed.
# =============================================================

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DB_NAME=aegis_db

# ── Gemini API Keys (add as many as you have) ────────────────
GEMINI_API_KEY_1=your_gemini_key_here
GEMINI_API_KEY_2=your_gemini_key_here
GEMINI_API_KEY_3=your_gemini_key_here
# ... add more as GEMINI_API_KEY_N=

# ── Ollama Fallback ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# ── Vision Service ────────────────────────────────────────────
VISION_PUSH_SECRET=your_shared_secret_here

# ── Firebase Realtime Database ────────────────────────────────
FIREBASE_RTDB_URL=https://<your-project>.firebasedatabase.app/.json
